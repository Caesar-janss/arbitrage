  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Arb.Core\Arb.Core.csproj" />
  </ItemGroup>

</Project>
